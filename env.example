# AUVRION - example environment configuration
# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Groq AI
GROQ_API_KEY=your-groq-api-key

# PayPal
# Use "sandbox" for testing. Use "live" only for production.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
